#define maxStress (_WorldScalars[0])
#define scaleFactor (_WorldScalars[1])
#define noiseMag (_WorldScalars[2])
#define interiorBand (_WorldScalars[3])
#define tectonicReach (_WorldScalars[4])
#define plateauStart (_WorldScalars[5])
#define ridgeSigmaBase (_WorldScalars[6])
#define ridgePeakShift (_WorldScalars[7])
#define ridgeExtent (_WorldScalars[8])
#define maxCD (_WorldScalars[9])
#define riftHalfWidth (_WorldScalars[10])
#define ridgeHalfWidth (_WorldScalars[11])
#define fractureHalfWidth (_WorldScalars[12])
