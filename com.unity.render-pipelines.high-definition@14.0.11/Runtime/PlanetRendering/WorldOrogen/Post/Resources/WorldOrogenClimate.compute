StructuredBuffer<float3> _WorldPositions;
StructuredBuffer<uint> _WorldNeighborOffsets,_WorldNeighbors;
StructuredBuffer<float> _WorldElevation;
int _WorldRegionCount,_ClimateSeason,_ClimateMode,_ClimateComponentMask;
StructuredBuffer<double> _ClimateParameters;
RWStructuredBuffer<float4> _ClimateGeoWrite;
StructuredBuffer<float4> _ClimateGeo;
RWStructuredBuffer<float3> _ClimateEastWrite,_ClimateNorthWrite;
StructuredBuffer<float3> _ClimateEast,_ClimateNorth;
RWStructuredBuffer<uint> _ClimateLandWrite;
StructuredBuffer<uint> _ClimateLand;
StructuredBuffer<int> _ClimateCoastLand,_ClimateCoastPlate,_ClimateCoastOcean,_ClimateCoastOceanWest,_ClimateCoastOceanEast;
StructuredBuffer<uint> _ClimatePlateOcean,_ClimateBinOffsets,_ClimateBinIndices;
