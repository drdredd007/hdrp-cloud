#pragma kernel BuildBaseMap
#pragma target 5.0
// Fan interpolation and colours derived from World Orogen planet-mesh.js/color-map.js.
// Upstream cc2662b4edd52231c4f65d8765f3ef12cd82d9b7, GPL-3.0-only.
StructuredBuffer<float3> _WorldPositions;
StructuredBuffer<float> _WorldElevation;
StructuredBuffer<int> _WorldNeighborOffsets,_WorldNeighbors,_WorldTriangles,_WorldHalfedges;
StructuredBuffer<int4> _MapNodes;
StructuredBuffer<int> _MapNeighborTriangles;
StructuredBuffer<float3> _MapCenters;
StructuredBuffer<uint> _MapKoppen;
RWStructuredBuffer<float4> _MapOutput;
RWStructuredBuffer<uint> _MapFailures;
int _MapRoot,_MapResolution,_MapView;

float HeightMetres(float e)
{if(e<=0)return e*10000;float t=min(e,1),t2=t*t;return 6000*t2*t2*(5-4*t);}
float3 Terrain(float e)
{
    if(e<-.5)return float3(.04,.06,.30);
    if(e<-.1){float t=(e+.5)/.4;return float3(.04+t*.07,.06+t*.14,.30+t*.18);}
    if(e<0){float t=(e+.1)/.1;return float3(.11+t*.19,.20+t*.22,.48+t*.12);}
    if(e<.002){float t=e/.002;return float3(.72+t*.08,.68-t*.02,.46-t*.10);}
    if(e<.25){float t=(e-.002)/.248;return float3(.20-t*.06,.54-t*.12,.12+t*.08);}
    if(e<.5){float t=(e-.25)/.25;return float3(.14+t*.30,.42-t*.14,.20-t*.06);}
    if(e<.75){float t=(e-.5)/.25;return float3(.44+t*.16,.28+t*.12,.14+t*.18);}
    float t=min(1,(e-.75)/.2);return float3(.60+t*.35,.40+t*.50,.32+t*.60);
}
static const float3 Biomes[31]={
    float3(0,0,0),float3(.05,.30,.05),float3(.08,.33,.07),float3(.42,.50,.18),float3(.82,.72,.50),
    float3(.60,.55,.48),float3(.72,.62,.30),float3(.55,.52,.32),float3(.18,.42,.12),float3(.12,.38,.10),
    float3(.10,.28,.10),float3(.45,.48,.22),float3(.40,.45,.20),float3(.35,.40,.20),float3(.20,.44,.14),
    float3(.15,.40,.12),float3(.12,.32,.10),float3(.12,.36,.08),float3(.10,.32,.08),float3(.06,.22,.08),
    float3(.05,.18,.07),float3(.38,.38,.18),float3(.35,.35,.17),float3(.08,.22,.08),float3(.06,.18,.07),
    float3(.14,.36,.10),float3(.12,.32,.09),float3(.07,.22,.08),float3(.05,.18,.07),float3(.35,.32,.22),float3(.78,.80,.84)};
static const float3 ClimateColours[31]={
    float3(.29,.44,.65),float3(0,0,1),float3(0,.47,1),float3(.27,.67,.98),float3(1,0,0),
    float3(1,.59,.59),float3(.96,.65,0),float3(1,.86,.39),float3(.78,1,.31),float3(.39,1,.31),
    float3(.20,.78,0),float3(1,1,0),float3(.78,.78,0),float3(.59,.59,0),float3(.59,1,.59),
    float3(.39,.78,.39),float3(.20,.59,.20),float3(0,1,1),float3(.22,.78,1),float3(0,.49,.49),
    float3(0,.27,.37),float3(.90,.50,1),float3(.70,.35,.85),float3(.50,.20,.65),float3(.35,.10,.45),
    float3(.67,.69,1),float3(.43,.47,.78),float3(.29,.31,.78),float3(.20,0,.53),float3(.70,.70,.70),float3(.41,.41,.41)};
float3 Satellite(uint k,float e)
{
    if(k==0||e<=0)return Terrain(e);float3 c=k<=30?Biomes[k]:float3(.30,.50,.20);
    float2 lines=k<=3?float2(3.5,5.5):k<=7?float2(3,5):k<=16?float2(2,3.5):
        (k<=18||k==21||k==22||k==25||k==26)?float2(1.5,3):k<=28?float2(.8,2):k==29?float2(.4,1.5):float2(0,.5);
    float h=HeightMetres(e)/1000;
    if(h<.2)c*=.93+.07*h/.2;
    if(lines.x>0&&h>.2&&h<lines.x)c*=1-(h-.2)/(lines.x-.2)*.15;
    if(lines.x>0&&h>lines.x){float t=min(1,(h-lines.x)/(lines.y>lines.x?lines.y-lines.x:2));c=lerp(c,float3(.42,.38,.32),t*t);}
    if(lines.y>0&&h>lines.y){float t=min(1,(h-lines.y)/2.5);c=lerp(c,float3(.92,.93,.96),t*t);}return c;
}
float3 MapColour(int r)
{
    float e=_WorldElevation[r];uint k=_MapKoppen[r];
    if(_MapView==1)
    {float3 c=Satellite(k,e),sum=0;int a=_WorldNeighborOffsets[r],b=_WorldNeighborOffsets[r+1];for(int j=a;j<b;j++){int n=_WorldNeighbors[j];sum+=Satellite(_MapKoppen[n],_WorldElevation[n]);}return lerp(c,sum/max(1,b-a),.35);}
    if(_MapView==2)return ClimateColours[min(k,30)];
    if(_MapView==3)return saturate((HeightMetres(e)+5000)/11000).xxx;
    return Terrain(e);
}
float TriangleHeight(int t)
{int s=t*3;float raw=(float)(((double)_WorldElevation[_WorldTriangles[s]]+_WorldElevation[_WorldTriangles[s+1]]+_WorldElevation[_WorldTriangles[s+2]])/3);return HeightMetres(raw);}

int Nearest(float3 q)
{
    int stack[32],top=0,best=-1;float minimum=1e30;stack[top++]=_MapRoot;
    while(top>0)
    {
        int n=stack[--top];int4 node=_MapNodes[n];float3 p=_WorldPositions[node.x];float d=dot(q-p,q-p);
        if(d<minimum||(d==minimum&&node.x<best)){minimum=d;best=node.x;}
        float delta=q[node.w]-p[node.w];int near=delta<0?node.y:node.z,far=delta<0?node.z:node.y;
        if(far>=0&&delta*delta<=minimum){if(top>=31)return -1;stack[top++]=far;}
        if(near>=0){if(top>=32)return -1;stack[top++]=near;}
    }return best;
}
bool Fan(float3 direction,int region,int inner,int outer,out float height)
{
    double3 a=(double3)_WorldPositions[region],b=(double3)_MapCenters[inner],c=(double3)_MapCenters[outer],q=(double3)direction;
    double3 ab=b-a,ac=c-a,n=double3(ab.y*ac.z-ab.z*ac.y,ab.z*ac.x-ab.x*ac.z,ab.x*ac.y-ab.y*ac.x);
    double denominator=n.x*q.x+n.y*q.y+n.z*q.z;height=0;
    if(abs(denominator)<1e-30)return false;
    double distance=(n.x*a.x+n.y*a.y+n.z*a.z)/denominator;if(distance<=0)return false;
    double3 at=q*distance-a;
    double aa=ab.x*ab.x+ab.y*ab.y+ab.z*ab.z,bb=ab.x*ac.x+ab.y*ac.y+ab.z*ac.z,cc=ac.x*ac.x+ac.y*ac.y+ac.z*ac.z;
    double x=at.x*ab.x+at.y*ab.y+at.z*ab.z,y=at.x*ac.x+at.y*ac.y+at.z*ac.z,det=aa*cc-bb*bb;
    if(det<=0)return false;double wb=(x*cc-y*bb)/det,wc=(y*aa-x*bb)/det,wa=1-wb-wc;
    if(min(wa,min(wb,wc))< -2e-7)return false;
    height=(float)(wa*(double)HeightMetres(_WorldElevation[region])+wb*TriangleHeight(inner)+wc*TriangleHeight(outer));return isfinite(height);
}
bool FindFan(float3 q,int r,out float4 value)
{
    int a=_WorldNeighborOffsets[r],b=_WorldNeighborOffsets[r+1];
    for(int j=a;j<b;j++)
    {int inner=_MapNeighborTriangles[j],s=inner*3;if(_WorldTriangles[s]!=r)s++;if(_WorldTriangles[s]!=r)s++;float height;if(Fan(q,r,inner,_WorldHalfedges[s]/3,height)){value=float4(MapColour(r),height);return true;}}
    value=0;return false;
}
float3 Cube(uint face,float a,float b)
{if(face==0)return float3(1,b,-a);if(face==1)return float3(-1,b,a);if(face==2)return float3(a,1,-b);if(face==3)return float3(a,-1,b);if(face==4)return float3(a,b,1);return float3(-a,b,-1);}
[numthreads(8,8,1)]
void BuildBaseMap(uint3 id:SV_DispatchThreadID)
{
    if(id.x>(uint)_MapResolution||id.y>(uint)_MapResolution||id.z>=6)return;
    float3 local=normalize(Cube(id.z,2.0*id.x/_MapResolution-1,2.0*id.y/_MapResolution-1));
    // Source export atan2(x,z) and host longitude atan2(z,x). Keep this explicit axis mapping outside generation.
    float3 sourceDirection=local.zyx;int r=Nearest(sourceDirection);float4 value=0;bool found=r>=0&&FindFan(sourceDirection,r,value);
    if(!found&&r>=0)
    {for(int j=_WorldNeighborOffsets[r];j<_WorldNeighborOffsets[r+1]&&!found;j++)found=FindFan(sourceDirection,_WorldNeighbors[j],value);}
    // Source cells use triangle averages, rather than Voronoi circumcentres. With jitter,
    // a cell containing this ray can lie beyond the nearest point's immediate neighbours.
    if(!found&&r>=0)
    {
        for(int secondRing=_WorldNeighborOffsets[r];secondRing<_WorldNeighborOffsets[r+1]&&!found;secondRing++)
        {
            int neighbour=_WorldNeighbors[secondRing];
            for(int candidate=_WorldNeighborOffsets[neighbour];candidate<_WorldNeighborOffsets[neighbour+1]&&!found;candidate++)
                found=FindFan(sourceDirection,_WorldNeighbors[candidate],value);
        }
    }
    if(!found){InterlockedAdd(_MapFailures[0],1);value=float4(-1,r,0,0);}
    uint side=_MapResolution+1;_MapOutput[(id.z*side+id.y)*side+id.x]=value;
}
